POSTGRES_USER=shopapi_user
POSTGRES_PASSWORD=shopapi_pass_dev
POSTGRES_DB=shopapi_db

# En LOCAL (hors Docker) → localhost:5434
DATABASE_URL=postgresql://shopapi_user:shopapi_pass_dev@localhost:5434/shopapi_db

# Dans DOCKER (docker-compose) → postgres:5432
# DATABASE_URL=postgresql://shopapi_user:shopapi_pass_dev@postgres:5432/shopapi_db

# Frontend autorise (CORS) : liste separee par des virgules
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
